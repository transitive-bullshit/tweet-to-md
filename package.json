{
  "name": "tweet-to-md",
  "version": "1.1.0",
  "description": "Converts a Tweet to Markdown for LLMs.",
  "license": "MIT",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transitive-bullshit/tweet-to-md.git"
  },
  "bin": {
    "tweet-to-md": "./build/cli.mjs"
  },
  "files": [
    "build"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./build/index.mjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "exports": {
    ".": {
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "run-s test:*",
    "test:format": "oxfmt --check",
    "test:lint": "oxlint",
    "test:typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "fix:format": "oxfmt",
    "fix:lint": "oxlint --fix",
    "prepare": "simple-git-hooks",
    "prerelease": "run-s test",
    "posttest": "run-s build",
    "release": "np --yolo"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@fisch0920/config": "^2.0.1",
    "@types/node": "^26.2.0",
    "lint-staged": "^17.3.0",
    "np": "^12.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.5.0"
}
